{
  "name": "petalas-skills",
  "private": true,
  "description": "Public agent skills and maintenance tooling for petalas/skills.",
  "homepage": "https://github.com/petalas/skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petalas/skills.git"
  },
  "bugs": {
    "url": "https://github.com/petalas/skills/issues"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "catalog:check": "bun scripts/sync-plugin-catalog.mjs --check",
    "catalog:sync": "bun scripts/sync-plugin-catalog.mjs",
    "check": "bun run format:check && bun run catalog:check && bun run policy:check && bun run router:check && bun run validate:fix-all-issues && bun run validate:local-plugins && bun run validate:pstack-imports && bun run test:pstack-imports",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "notices:sync": "bun scripts/sync-pstack-notices.mjs",
    "policy:check": "bun scripts/sync-openai-policy.mjs --check",
    "policy:sync": "bun scripts/sync-openai-policy.mjs",
    "report:pstack-updates": "bun scripts/report-pstack-updates.mjs",
    "router:check": "bun scripts/sync-router-index.mjs --check",
    "router:sync": "bun scripts/sync-router-index.mjs",
    "test:pstack-imports": "bun scripts/test-pstack-imports.mjs",
    "validate:fix-all-issues": "bun scripts/validate-fix-all-issues.mjs",
    "validate:local-plugins": "bun scripts/validate-local-plugins.mjs",
    "validate:pstack-imports": "bun scripts/validate-pstack-imports.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "skills": "1.5.23"
  }
}
